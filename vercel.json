
{
  "version": 2,
  "builds": [
    {
      "src": "a.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "node_modules/@astrologer/ephemera/wasm/**"
      }
    },
    {
      "src": "matchmaking.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "node_modules/@astrologer/ephemera/wasm/**"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/matchmaking",
      "dest": "matchmaking.js"
    },
    {
      "src": "/(.*)",
      "dest": "a.js"
    }
  ]
}
